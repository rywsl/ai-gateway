# ----- Builder stage -----
FROM rust:1.88-bookworm AS builder
WORKDIR /build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        cmake \
        make \
        pkg-config \
        perl \
        libssl-dev \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY config ./config

# See main Dockerfile: drop the `components` line so rustup uses the base
# image's pre-installed 1.88 toolchain instead of downloading rustfmt/clippy
# from static.rust-lang.org (unnecessary for `cargo build`, flaky on some
# networks). Host/CI rust-toolchain.toml is untouched.
RUN sed -i '/^components = /d' rust-toolchain.toml

RUN cargo build --release --locked -p e2e-fake-upstream \
 && strip /build/target/release/fake_upstream

# ----- Runtime stage -----
FROM debian:bookworm-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/fake_upstream /usr/local/bin/fake_upstream

EXPOSE 9000 9001 9443

ENV RUST_LOG=info

ENTRYPOINT ["/usr/local/bin/fake_upstream"]
